# ==============================================================================
# SOC Incident Response Evidence & Timeline Reporter — Environment Configuration
# Copy this file to `.env` before deploying:
#   cp .env.example .env
#
# Generate a strong cryptographic secret key with:
#   openssl rand -base64 48
#   OR
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# ==============================================================================

# REQUIRED: Cryptographic secret key used by Django for signing sessions/tokens.
# Must be set to a unique random string; the application will refuse to start if empty.
DJANGO_SECRET_KEY=

# OPTIONAL: Enable Django debug mode (set to False in production/Docker deployments)
DJANGO_DEBUG=False

# OPTIONAL: Comma-separated list of allowed hostnames/IPs (e.g. localhost,127.0.0.1,192.168.1.50)
DJANGO_ALLOWED_HOSTS=*

# OPTIONAL: Host port exposed by the frontend Nginx container (default: 5173)
APP_PORT=5173

# OPTIONAL: Number of Gunicorn worker processes inside the backend container (default: 3)
GUNICORN_WORKERS=3
