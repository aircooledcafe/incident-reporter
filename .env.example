# ==============================================================================
# SOC Incident Response Evidence & Timeline Reporter — Environment Configuration
# Copy this file to `.env` before deploying:
#   cp .env.example .env
#
# Generate a strong cryptographic secret key with:
#   openssl rand -base64 48
#   OR
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# ==============================================================================

# REQUIRED: Cryptographic secret key used by Django for signing sessions/tokens.
# Must be set to a unique random string; the application will refuse to start if empty.
DJANGO_SECRET_KEY=

# OPTIONAL: Enable Django debug mode (set to False in production/Docker deployments)
DJANGO_DEBUG=False

# OPTIONAL: Comma-separated list of allowed hostnames/IPs (e.g. localhost,127.0.0.1,192.168.1.50)
DJANGO_ALLOWED_HOSTS=*

# OPTIONAL: Comma-separated list of trusted origins for CSRF behind reverse proxies / HTTPS
# Example: https://incidents.internal.example,http://192.168.1.50:5173
DJANGO_CSRF_TRUSTED_ORIGINS=

# OPTIONAL: External / host persistent storage paths mounted into Docker containers.
# Can point to local host directories, NAS/NFS mounts, or SAN volumes so all databases,
# user/role/session tables, screenshots, manifests, and reports live outside containers.
HOST_DB_DIR=./data/db
HOST_ARTIFACTS_DIR=./artifacts

# OPTIONAL: Initial Super Admin account bootstrap on startup (leave blank to configure
# via the web UI first-run setup screen or `manage.py createsuperuser`).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# OPTIONAL: Host ports exposed by Docker Compose (defaults: 5173 for Nginx UI, 8000 for Backend API)
APP_PORT=5173
BACKEND_PORT=8000

# OPTIONAL: Number of Gunicorn worker processes inside the backend container (default: 3)
GUNICORN_WORKERS=3
