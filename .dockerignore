# Git
.git
.gitignore

# Python / Virtualenvs
**/__pycache__
**/*.py[cod]
**/*$py.class
backend/.venv
.venv
venv
backend/db.sqlite3
*.sqlite3

# Node / Frontend build artifacts
frontend/node_modules
frontend/dist
node_modules
dist
npm-debug.log*

# Local persistent data & investigation artifacts (mounted via volumes at runtime)
data/db/*
!data/db/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Documentation & sample assets (not needed inside container build context)
samples

# OS / IDE
.DS_Store
.vscode
.idea
.env
